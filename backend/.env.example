# ============================================================
# 闪照小程序 - 后端配置模板
# 复制此文件为 .env 并填写实际值（安装向导会自动生成 .env）
# ============================================================

# App
PORT=3000
APP_ENV=production

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=shanzhao

# JWT 密钥（随机长字符串，勿泄露）
JWT_SECRET=
ADMIN_JWT_SECRET=

# 微信小程序
WX_APPID=
WX_SECRET=

# 存储驱动：local（本地）/ cos（腾讯云）/ oss（阿里云）
# local 模式图片 URL 为相对路径，前端自动拼域名，无需配置
STORAGE_DRIVER=local

# ── 腾讯云 COS（STORAGE_DRIVER=cos 时填写）─────────────────
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=your-bucket-1234567890
# COS_REGION=ap-guangzhou
# COS_CDN=

# ── 阿里云 OSS（STORAGE_DRIVER=oss 时填写）─────────────────
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_REGION=oss-cn-hangzhou
# OSS_CDN=
